--- diagnostic/ir_aug_audit/_before/scripts_train.py	2026-10-04 23:23:10.385004600 +0800
+++ scripts/train.py	2026-10-04 23:23:33.596613900 +0800
@@ -547,6 +547,28 @@
     if "ir_encoding" in train_cfg:
         kwargs["ir_encoding"] = str(train_cfg["ir_encoding"])
 
+    # IR-specific 光度增强（可选）：仅在配置中存在时转发；未配置时走 default.yaml 的
+    # 「恒等 + 关闭」默认值 -> 既有实验（含 D′）的数据流与 RNG 序列逐位不变。
+    # 四个键必须一起出现才是"IR augmentation 实验"；只写其中一部分由 base.py 的
+    # apply_ir_augmentation 按各自默认值处理（缺 probability 即为关闭）。
+    _ir_aug_keys = ("ir_gamma", "ir_gamma_probability", "ir_noise_std", "ir_noise_probability")
+    if any(k in train_cfg for k in _ir_aug_keys):
+        _g = train_cfg.get("ir_gamma", [1.0, 1.0])
+        if isinstance(_g, (int, float)):
+            _g = [float(_g), float(_g)]
+        kwargs["ir_gamma"] = [float(_g[0]), float(_g[1])]
+        assert kwargs["ir_gamma"][0] > 0.0 and kwargs["ir_gamma"][1] > 0.0, \
+            f"ir_gamma must be positive, got {kwargs['ir_gamma']}"
+        kwargs["ir_gamma_probability"] = float(train_cfg.get("ir_gamma_probability", 0.0))
+        kwargs["ir_noise_std"] = float(train_cfg.get("ir_noise_std", 0.0))
+        kwargs["ir_noise_probability"] = float(train_cfg.get("ir_noise_probability", 0.0))
+        for _k in _ir_aug_keys:
+            _v = kwargs[_k]
+            if isinstance(_v, float) and _v < 0.0:
+                raise ValueError(f"{_k} must be >= 0, got {_v}")
+        print(f"[train] IR aug: gamma={kwargs['ir_gamma']} p={kwargs['ir_gamma_probability']} "
+              f"noise_std={kwargs['ir_noise_std']} p={kwargs['ir_noise_probability']}")
+
     # 冻结层（可选）：仅在配置中存在时转发。ultralytics 的 freeze 语义是
     # "冻结名字含 model.<x>. 的参数"，x 可混用层序号(int)与子模块路径(str)，
     # 因此可用混合列表精确表达"只训练某几个新增参数"。未配置时行为不变。
